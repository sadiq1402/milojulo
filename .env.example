# Supabase (the mobile app reads its URL and anon key from apps/mobile/src/config/env.ts, see apps/mobile/README.md)
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=         # server-side only, never in the app
SUPABASE_DB_PASSWORD=        # supabase link / db push (session pooler, IPv4)

# Cloudflare R2 (S3-compatible), used by the media-signing Edge Function
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=milojulo-media

# Auth email over SMTP (Resend), read by `supabase config push` for the cloud project
SMTP_PASS=

# Email provider (called by API from Edge Functions)
EMAIL_API_KEY=
EMAIL_FROM=

# Push (FCM only; google-services.json for Android lives in apps/mobile/android/app)
FCM_SERVICE_ACCOUNT_JSON=    # used by the push Edge Function

# Turnstile
TURNSTILE_SECRET=

# Monitoring
SENTRY_DSN=

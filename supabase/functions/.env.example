# Edge Function secrets. Locally: copy to supabase/functions/.env (gitignored), which
# `supabase functions serve` loads. In the cloud: `supabase secrets set --env-file <file>`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to every function by Supabase.

# media: Cloudflare R2 (private bucket), S3 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# push, account-purge, purge-chat-media, copy-evidence: the shared secret the database sends when it calls
# them (Vault entry `service_role_key` holds the same value). Any long random string: `openssl rand -hex 32`.
DISPATCH_SECRET=

# places: a Google Maps Platform key with Places API (New) enabled, restricted to that API.
GOOGLE_PLACES_KEY=

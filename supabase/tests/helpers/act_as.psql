-- Shared test helpers; include with \ir from a test file inside its transaction.
create extension if not exists pgtap with schema extensions;

-- The local database may hold development data (seeded or from the app); hide those Members so
-- each test sees only its own. The test's transaction is rolled back, so nothing real changes.
update public.profiles set hidden_at = now() where hidden_at is null;

create function pg_temp.act_as_member(member_id uuid, user_metadata jsonb default '{}') returns void
language sql as $$
  select set_config('request.jwt.claims', jsonb_build_object(
    'sub', member_id, 'role', 'authenticated',
    'app_metadata', '{}'::jsonb, 'user_metadata', user_metadata)::text, true);
  set local role authenticated;
$$;

create function pg_temp.act_as_admin(admin_id uuid) returns void
language sql as $$
  select set_config('request.jwt.claims', jsonb_build_object(
    'sub', admin_id, 'role', 'authenticated',
    'app_metadata', '{"role":"admin"}'::jsonb)::text, true);
  set local role authenticated;
$$;

create function pg_temp.act_as_anon() returns void
language sql as $$
  select set_config('request.jwt.claims', '{"role":"anon"}', true);
  set local role anon;
$$;

-- What Edge Functions run as.
create function pg_temp.act_as_service() returns void
language sql as $$
  select set_config('request.jwt.claims', '{"role":"service_role"}', true);
  set local role service_role;
$$;

-- An auth account with no profile yet (what sign-in produces). Run as postgres.
create function pg_temp.create_account(account_id uuid) returns void
language sql as $$
  insert into auth.users (id, email, aud, role)
  values (account_id, account_id || '@test.milojulo', 'authenticated', 'authenticated');
$$;

-- The latest effective version of each consent document.
create function pg_temp.current_docs() returns uuid[]
language sql stable as $$
  select array_agg(id) from (select distinct on (kind) id from public.consent_documents
                             where effective_at <= now() order by kind, effective_at desc) d;
$$;

-- A Member who has given their date of birth and accepted every current document. Run as postgres.
create function pg_temp.create_member(member_id uuid) returns void
language plpgsql as $$
begin
  perform pg_temp.create_account(member_id);
  perform pg_temp.act_as_member(member_id);
  perform public.accept_consents('1995-06-15',
    pg_temp.current_docs());
  reset role;
end;
$$;

-- A Member whose profile meets the minimum but is not yet submitted. Run as postgres.
create function pg_temp.create_complete_member(member_id uuid) returns void
language plpgsql as $$
begin
  perform pg_temp.create_member(member_id);
  update public.profiles set display_name = 'Test', area_id = 'baner', modes = '{friends}'
  where id = member_id;
  insert into public.profile_prompts (user_id, position, question_id, answer)
  select member_id, p, (select min(id) from public.prompt_questions), 'An answer'
  from generate_series(1, 2) p;
  insert into public.photos (user_id, object_key, position, uploaded_at)
  select member_id, member_id || '/' || p || '.jpg', p, now()
  from generate_series(1, 2) p;
end;
$$;

-- A Member with a Submitted Profile, visible to others. Run as postgres.
create function pg_temp.create_visible_member(member_id uuid, member_modes public.mode[] default '{friends}')
returns void
language plpgsql as $$
begin
  perform pg_temp.create_complete_member(member_id);
  update public.profiles set modes = member_modes where id = member_id;
  perform pg_temp.act_as_member(member_id);
  perform public.submit_profile();
  reset role;
end;
$$;

-- An accepted Connection under the given Mode between two Members (new visible ones unless
-- create_members is false). Run as postgres; leaves the role reset.
create function pg_temp.accepted_pair(a uuid, b uuid, conn_mode public.mode default 'friends',
  create_members boolean default true) returns uuid
language plpgsql as $$
declare
  conn uuid;
begin
  if create_members then
    perform pg_temp.create_visible_member(a);
    perform pg_temp.create_visible_member(b);
  end if;
  perform pg_temp.act_as_member(a);
  conn := public.send_request(b, conn_mode);
  perform pg_temp.act_as_member(b);
  perform public.respond_request(conn, true);
  reset role;
  return conn;
end;
$$;

-- A chat upload slot the media function made but has not confirmed; returns its upload id.
-- Run as postgres; leaves the role reset.
create function pg_temp.chat_slot(sender uuid, conn uuid, kind public.message_type, size integer default 1000)
returns uuid
language plpgsql as $$
declare
  slot uuid;
begin
  perform pg_temp.act_as_service();
  select upload_id into slot from public.start_chat_upload(sender, conn, kind, size);
  reset role;
  return slot;
end;
$$;

-- A slot the media function made and confirmed (its file arrived); returns the media key a
-- message carries. Run as postgres; leaves the role reset.
create function pg_temp.chat_upload(sender uuid, conn uuid, kind public.message_type) returns text
language plpgsql as $$
declare
  slot uuid := pg_temp.chat_slot(sender, conn, kind);
  key text;
begin
  perform pg_temp.act_as_service();
  key := public.confirm_chat_upload(sender, slot);
  reset role;
  return key;
end;
$$;

-- The mime a message of each media kind carries.
create function pg_temp.mime_of(kind public.message_type) returns text
language sql as $$
  select case kind when 'image' then 'image/jpeg' when 'video' then 'video/mp4' else 'audio/mp4' end;
$$;

-- A media message insert (on conflict do nothing, as the app retries), to pass to lives_ok /
-- throws_ok. The mime defaults to the kind's, the duration to 1 s for video and voice.
create function pg_temp.media_insert(msg_id uuid, sender uuid, conn uuid, kind public.message_type, key text,
  duration_ms integer default null, mime text default null) returns text
language sql as $$
  select format($q$ insert into public.messages
                      (id, connection_id, sender_id, type, media_key, media_mime, media_duration_ms)
                    values (%L, %L, %L, %L, %L, %L, %L) on conflict (id) do nothing $q$,
                msg_id, conn, sender, kind, key, coalesce(mime, pg_temp.mime_of(kind)),
                coalesce(duration_ms, case when kind in ('video', 'voice') then 1000 end));
$$;

-- The message ids the media function's chat-urls would sign for the viewer. Run as postgres.
create function pg_temp.media_links(viewer uuid, ids uuid[]) returns setof uuid
language plpgsql as $$
begin
  perform pg_temp.act_as_service();
  return query select l.message_id from public.chat_media_links(viewer, ids) l order by 1;
end;
$$;

-- One kind of event on a topic, as a subscriber Realtime admits (select with the topic set).
create function pg_temp.broadcasts_on(topic text, kind text default 'message') returns setof jsonb
language sql as $$
  select set_config('realtime.topic', topic, true);
  select payload from realtime.messages m where m.topic = broadcasts_on.topic and m.event = kind;
$$;
